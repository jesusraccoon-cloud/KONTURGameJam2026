--- !u!114 &5801586632110197952
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3132128845172897098}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0418\u0433\u0440\u0430 \"\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u0418\u0433\u0440\u044B\"\n\xA9 2025 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\n\n\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430\nGame Director: \u0418\u0432\u0430\u043D
    \u0418\u0432\u0430\u043D\u043E\u0432\nExecutive Producer: \u0410\u043D\u043D\u0430
    \u041F\u0435\u0442\u0440\u043E\u0432\u0430\n\n\u0413\u0435\u0439\u043C-\u0434\u0438\u0437\u0430\u0439\u043D\nLead
    Game Designer: \u0421\u0435\u0440\u0433\u0435\u0439 \u0421\u0438\u0434\u043E\u0440\u043E\u0432\nLevel
    Designers: \u041C\u0430\u0440\u0438\u044F \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432\u0430,
    \u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u0412\u043E\u043B\u043A\u043E\u0432\nNarrative
    Designers: \u041E\u043B\u044C\u0433\u0430 \u0421\u043C\u0438\u0440\u043D\u043E\u0432\u0430,
    \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041B\u0435\u0431\u0435\u0434\u0435\u0432\n\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430\nTechnical
    Director: \u041D\u0438\u043A\u043E\u043B\u0430\u0439 \u0424\u0435\u0434\u043E\u0440\u043E\u0432\nGameplay
    Programmers: \u0415\u043B\u0435\u043D\u0430 \u0420\u043E\u043C\u0430\u043D\u043E\u0432\u0430,
    \u041C\u0430\u043A\u0441\u0438\u043C \u041A\u043E\u0437\u043B\u043E\u0432\nAI
    Programmers: \u0412\u0438\u043A\u0442\u043E\u0440\u0438\u044F \u0411\u0435\u043B\u043E\u0432\u0430\nUI
    Programmers: \u0410\u043D\u0434\u0440\u0435\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\nTools
    & Engine Programmers: \u041F\u0430\u0432\u0435\u043B \u041E\u0440\u043B\u043E\u0432\n\n\u0425\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B\nArt Director: \u0421\u0432\u0435\u0442\u043B\u0430\u043D\u0430
    \u0412\u0430\u0441\u0438\u043B\u044C\u0435\u0432\u0430\n2D Artists: \u042E\u043B\u0438\u044F
    \u041C\u043E\u0440\u043E\u0437\u043E\u0432\u0430, \u0418\u0433\u043E\u0440\u044C
    \u0413\u0440\u0438\u0433\u043E\u0440\u044C\u0435\u0432\n3D Artists: \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u041F\u043E\u043F\u043E\u0432, \u0414\u0430\u0440\u044C\u044F \u0417\u0430\u0445\u0430\u0440\u043E\u0432\u0430\nConcept
    Artists: \u0420\u043E\u043C\u0430\u043D \u0412\u043E\u043B\u043A\u043E\u0432\nVFX
    Artists: \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430 \u041F\u0430\u0432\u043B\u043E\u0432\u0430\n\n\u0410\u043D\u0438\u043C\u0430\u0446\u0438\u044F\nLead
    Animator: \u041C\u0430\u0440\u0438\u043D\u0430 \u041B\u0435\u0431\u0435\u0434\u0435\u0432\u0430\nCharacter
    Animators: \u041F\u0430\u0432\u0435\u043B \u0421\u043E\u043A\u043E\u043B\u043E\u0432,
    \u0422\u0430\u0442\u044C\u044F\u043D\u0430 \u041C\u0438\u0440\u043E\u043D\u043E\u0432\u0430\nCinematic
    Animators: \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0420\u043E\u043C\u0430\u043D\u043E\u0432\n\n\u0417\u0432\u0443\u043A
    \u0438 \u043C\u0443\u0437\u044B\u043A\u0430\nAudio Director: \u041D\u0438\u043A\u043E\u043B\u0430\u0439
    \u041A\u0440\u044B\u043B\u043E\u0432\nSound Designers: \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u041A\u0443\u0437\u044C\u043C\u0438\u043D, \u0418\u0440\u0438\u043D\u0430 \u0424\u0435\u0434\u043E\u0440\u043E\u0432\u0430\n\u041A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043E\u0440:
    \u0421\u0435\u0440\u0433\u0435\u0439 \u041E\u0440\u043B\u043E\u0432\n\u041E\u0437\u0432\u0443\u0447\u043A\u0430
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439:\n\u2014 \u0418\u0432\u0430\u043D
    \u0418\u0432\u0430\u043D\u043E\u0432 (\u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0433\u0435\u0440\u043E\u0439)\n\u2014 \u041C\u0430\u0440\u0438\u044F \u0421\u043C\u0438\u0440\u043D\u043E\u0432\u0430
    (\u0410\u043D\u0442\u0430\u0433\u043E\u043D\u0438\u0441\u0442)\n\n\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0438 \u043E\u043F\u044B\u0442\nUI
    Designer: \u0410\u043D\u043D\u0430 \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u0432\u0430\nUX
    Researcher: \u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\n\n\u0422\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435\nQA
    Lead: \u041E\u043B\u044C\u0433\u0430 \u041F\u0435\u0442\u0440\u043E\u0432\u0430\nQA
    Testers: \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432,
    \u0415\u043B\u0435\u043D\u0430 \u0421\u043E\u043A\u043E\u043B\u043E\u0432\u0430\n\n\u041B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F\nLocalization
    Manager: \u042E\u043B\u0438\u044F \u0411\u0435\u043B\u043E\u0432\u0430\n\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0438:
    \u0418\u0432\u0430\u043D \u0421\u0438\u0434\u043E\u0440\u043E\u0432, \u041C\u0430\u0440\u0438\u043D\u0430
    \u041C\u043E\u0440\u043E\u0437\u043E\u0432\u0430\nLocalization QA: \u0410\u043D\u0434\u0440\u0435\u0439
    \u0412\u043E\u043B\u043A\u043E\u0432\n\n\u041C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433
    \u0438 PR\nMarketing Director: \u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u041F\u0430\u0432\u043B\u043E\u0432\nCommunity
    Managers: \u041D\u0430\u0442\u0430\u043B\u044C\u044F \u041E\u0440\u043B\u043E\u0432\u0430,
    \u0421\u0435\u0440\u0433\u0435\u0439 \u041A\u043E\u0437\u043B\u043E\u0432\nSocial
    Media Team: \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0430 \u0418\u0432\u0430\u043D\u043E\u0432\u0430\n\n\u0418\u0437\u0434\u0430\u0442\u0435\u043B\u044C\nPublishing
    Team: \u041E\u041E\u041E \"\u0418\u0437\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0430\u044F
    \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\"\nProducer from Publisher:
    \u041C\u0438\u0445\u0430\u0438\u043B \u041B\u0435\u0431\u0435\u0434\u0435\u0432\n\n\u0412\u043D\u0435\u0448\u043D\u0438\u0435
    \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u044B\n\u0424\u0440\u0438\u043B\u0430\u043D\u0441\u0435\u0440\u044B:
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0421\u043C\u0438\u0440\u043D\u043E\u0432,
    \u0412\u0438\u043A\u0442\u043E\u0440\u0438\u044F \u041C\u043E\u0440\u043E\u0437\u043E\u0432\u0430\nMotion
    Capture Studio: \u041E\u041E\u041E \"MotionArt\"\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438\n\u0418\u0433\u0440\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u0430 \u043D\u0430
    Unity Engine\n\u0421\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438:
    Zenject, DOTween, FMOD\n\n\u042E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\n\xA9 2025 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\n\u0412\u0441\u0435
    \u043F\u0440\u0430\u0432\u0430 \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B.\nUnity
    \u0438 \u043B\u043E\u0433\u043E\u0442\u0438\u043F Unity \u2014 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u043C\u0430\u0440\u043A\u0438
    Unity Technologies.\n\n\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u043D\u0430\u0448\u0438\u043C \u0441\u0435\u043C\u044C\u044F\u043C \u0437\u0430
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443.\n\u041E\u0441\u043E\u0431\u0430\u044F
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
    \u043D\u0430\u0448\u0438\u043C \u0434\u0440\u0443\u0437\u044C\u044F\u043C \u0438
    \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430\u043C.\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0432\u0441\u0435\u043C, \u043A\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u043B
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438.\n\n\u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E
    \u0438 \u0438\u0433\u0440\u043E\u043A\u0438\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0432\u0441\u0435\u043C \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C
    \u0430\u043B\u044C\u0444\u0430- \u0438 \u0431\u0435\u0442\u0430-\u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0432\u0448\u0438\u043C \u043D\u0430\u0441
    \u043D\u0430 Kickstarter.\n\n\u0421\u0430\u0443\u043D\u0434\u0442\u0440\u0435\u043A\n\u041C\u0443\u0437\u044B\u043A\u0430
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043D\u0430 Spotify \u0438
    Bandcamp.\n\u0410\u0432\u0442\u043E\u0440 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0439:
    \u0421\u0435\u0440\u0433\u0435\u0439 \u041E\u0440\u043B\u043E\u0432.\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E
    \u0437\u0430 \u0438\u0433\u0440\u0443!\n\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438
    \u0432 \u043D\u043E\u0432\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445!"
